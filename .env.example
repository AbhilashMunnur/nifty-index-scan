# --- Angel One SmartAPI (required) ---
# Create a Trading API app at smartapi.angelone.in.
# ANGEL_TOTP_SECRET is the text string beside the 2FA QR code, not the 6-digit code.
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# --- FYERS API (optional; Prime needed for multi-year 15m futures) ---
# Create an app at myapi.fyers.in with Market Data permission.
# Run: python scripts/setup_fyers.py
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
FYERS_ACCESS_TOKEN=

# --- DhanHQ API (optional) ---
# Paste daily access token from web.dhan.co → My Profile → Access DhanHQ APIs
# Also mirrored in secrets/dhan_token.json (gitignored).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Optional: Telegram notifications ---
# TELEGRAM_CHAT_ID accepts several recipients, comma separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional: mirror the trade journal into Google Sheets ---
# Paste the whole service account JSON on one line, or give a path to the file.
GOOGLE_SERVICE_ACCOUNT_JSON=
